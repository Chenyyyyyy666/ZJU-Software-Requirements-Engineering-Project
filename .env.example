# ============================================================
# 智能体动态记忆管理 - 环境变量模板
# 使用方式：
#   1. 复制本文件为 .env          cp .env.example .env
#   2. 在 .env 中填入自己的 key
# 注意：
#   - .env 已被 .gitignore 忽略，绝不会入库；本文件必须入库作为模板
#   - 每人使用自己的 key，不要互相传递真实密钥
#   - 统一使用 DeepSeek 官方接口，不使用中转站
#   - 关闭 thinking 模式由代码中的调用参数控制，不通过环境变量设置
# ============================================================

# ---------- DeepSeek API ----------
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 单次请求超时时间（秒）
DEEPSEEK_TIMEOUT=60

# ---------- 数据 ----------
# 课程评测约定：数据文件放在仓库根目录
LOCOMO_DATA_PATH=./locomo.json

# ---------- 检索 ----------
# 检索取回的记忆条数，可自行调整（不是越大越好）
RETRIEVAL_TOP_K=10

# ---------- 缓存 ----------
# 缓存目录：复用模型响应，避免重复调用产生费用；该目录已被忽略
CACHE_DIR=./cache

# ---------- 运行与日志 ----------
LOG_LEVEL=INFO

# ---------- Web 应用 ----------
WEB_HOST=127.0.0.1
WEB_PORT=8000
